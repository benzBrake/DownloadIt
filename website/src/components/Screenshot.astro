---
import { Image } from "astro:assets";
import DownloadSoundDemo from "./DownloadSoundDemo.astro";
import DownloadHistoryDemo from "./DownloadHistoryDemo.astro";
import type { ImageMetadata } from "astro";
import { currentLocale } from "../data/site";
import { screenshotDescription, type ScreenshotId } from "../data/screenshots";

interface Props {
  id: ScreenshotId;
  eager?: boolean;
  onDark?: boolean;
}

const { id, eager = false, onDark = false } = Astro.props;
const locale = currentLocale(Astro.locals.starlightRoute.lang);
const description = screenshotDescription(id, locale);
const isHistoryDemo = id === "download-history";
const isDemo = isHistoryDemo || id === "download-history-settings";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/*.png",
  { eager: true },
);
const image = images[`../assets/screenshots/${id}.png`]?.default;
const stageStyle = isHistoryDemo
  ? { aspectRatio: "auto", minHeight: "0" }
  : isDemo
  ? { aspectRatio: "16 / 10", minHeight: "0" }
  : image && (id === "download-dialog-save-to" || id === "ytdlp-menu")
  ? { aspectRatio: id === "ytdlp-menu" ? "4 / 3" : `${image.width} / ${image.height}`, minHeight: "0" }
  : undefined;
---

<figure class:list={["product-screenshot", { "on-dark": onDark }]} data-screenshot={id}>
  <div class="screenshot-stage" style={stageStyle}>
    {isHistoryDemo ? (
      <DownloadHistoryDemo />
    ) : isDemo ? (
      <DownloadSoundDemo />
    ) : image ? (
      <a class="screenshot-link" href={image.src}>
        <Image src={image} alt={description} loading={eager ? "eager" : "lazy"} decoding="async" style={id === "ytdlp-menu" ? "object-fit: cover; object-position: left center;" : undefined} />
      </a>
    ) : (
      <div class="screenshot-placeholder">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8" cy="9" r="1.5" /><path d="m3 17 5-5 4 4 3-3 6 6" /></svg>
        <span>{locale === "zh-CN" ? "界面预览待补充" : "Interface preview coming soon"}</span>
      </div>
    )}
  </div>
  <figcaption>{description}{image && !isDemo && locale === "en" ? " (Chinese interface.)" : ""}</figcaption>
</figure>

<style>
  .product-screenshot { margin: 2rem 0; min-width: 0; color: var(--sl-color-text); }
  .screenshot-stage { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; background: var(--sl-color-bg-sidebar); }
  .screenshot-link { position: absolute; inset: 0; }
  .screenshot-stage img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .screenshot-placeholder { display: grid; justify-items: center; align-content: center; gap: 0.7rem; padding: clamp(1rem, 4vw, 2.5rem); text-align: center; }
  .screenshot-placeholder svg { color: var(--sl-color-text-accent); }
  .screenshot-placeholder span { color: var(--sl-color-white); font-weight: 600; }
  figcaption { margin-top: 0.65rem; color: var(--sl-color-gray-3); font-size: 0.85rem; line-height: 1.6; }
  .on-dark figcaption { color: #d8d8df; }
  @media (max-width: 30rem) { .screenshot-stage { aspect-ratio: auto; min-height: 14rem; } }
</style>
