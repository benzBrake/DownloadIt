---
import { currentLocale } from "../data/site";
import completionSound from "../../../addon/chrome/content/sounds/download-complete.wav?url";

const isZh = currentLocale(Astro.locals.starlightRoute.lang) === "zh-CN";
const copy = isZh ? {
  description: "有声操作演示：点击播放，开启下载完成提示音并应用设置，下载示例 PDF，完成后播放一次内置提示音。",
  settings: "下载历史", settingsStep: "01 / 设置", cleanup: "在下载历史中显示清理按钮",
  sound: "下载完成时播放提示音", source: "提示音", builtin: "内置提示音",
  volume: "音量", preview: "试听", apply: "应用", downloads: "文档下载",
  downloadStep: "02 / 下载", document: "DownloadIt 使用指南", download: "下载",
  ready: "PDF 文档 · 2.4 MB", downloading: "正在下载…", complete: "下载完成",
  chime: "完成提示音", chimeNote: "播放内置提示音",
  stepOne: "开启提示音，然后应用设置", stepTwo: "点击文档，开始下载", stepThree: "下载完成，提示音响起",
  play: "播放有声演示", replay: "重播（有声）", stop: "停止", loading: "正在准备…",
  error: "提示音加载或播放失败，请点击重试。",
} : {
  description: "Sound demonstration: click to play, enable and apply the completion sound, download a sample PDF, then play the built-in chime once when it finishes.",
  settings: "Download history", settingsStep: "01 / SETTINGS", cleanup: "Show history cleanup buttons",
  sound: "Play sound on completion", source: "Sound", builtin: "Built-in chime",
  volume: "Volume", preview: "Preview", apply: "Apply", downloads: "Document download",
  downloadStep: "02 / DOWNLOAD", document: "DownloadIt user guide", download: "Download",
  ready: "PDF document · 2.4 MB", downloading: "Downloading…", complete: "Download complete",
  chime: "Completion sound", chimeNote: "Built-in chime playing",
  stepOne: "Enable sound, then apply settings", stepTwo: "Click the document to download", stepThree: "Download complete. Hear the chime.",
  play: "Play demo with sound", replay: "Replay with sound", stop: "Stop", loading: "Preparing…",
  error: "The sound could not load or play. Click to try again.",
};
---

<download-sound-demo data-state="idle">
  <svg class="scene" viewBox="0 0 800 500" width="800" height="500" role="img" aria-label={copy.description}>
    <rect width="800" height="500" fill="#edf4f8" />
    <circle cx="766" cy="40" r="170" fill="#e0eef6" />
    <circle cx="20" cy="490" r="110" fill="#e3eef4" />
    <rect x="32" y="32" width="736" height="392" rx="16" fill="#fff" stroke="#d5e0e7" />
    <path d="M48 32h704a16 16 0 0 1 16 16v40H32V48a16 16 0 0 1 16-16Z" fill="#f7f9fb" />
    <circle cx="58" cy="60" r="5" fill="#d0dae2" />
    <circle cx="76" cy="60" r="5" fill="#d0dae2" />
    <circle cx="94" cy="60" r="5" fill="#d0dae2" />
    <text x="122" y="67" class="brand">DownloadIt</text>
    <path d="M32 88h736" stroke="#e3e9ef" />

    <g class="settings animated">
      <text x="66" y="128" class="heading">{copy.settings}</text>
      <text x="734" y="125" text-anchor="end" class="eyebrow">{copy.settingsStep}</text>
      <text x="66" y="177" class="label">{copy.cleanup}</text>
      <rect x="674" y="154" width="54" height="28" rx="14" fill="#168ac5" />
      <circle cx="714" cy="168" r="10" fill="#fff" />
      <path d="M66 195h668" stroke="#e8edf2" />
      <text x="66" y="226" class="label">{copy.sound}</text>
      <rect class="sound-toggle animated" x="674" y="203" width="54" height="28" rx="14" fill="#c6d0da" />
      <circle class="sound-thumb animated" cx="688" cy="217" r="10" fill="#fff" />
      <text x="66" y="282" class="muted">{copy.source}</text>
      <rect x="190" y="256" width="544" height="40" rx="7" fill="#f6f8fa" stroke="#dce4eb" />
      <text x="206" y="282" class="muted">{copy.builtin}</text>
      <text x="66" y="337" class="muted">{copy.volume}</text>
      <path d="M190 330h310" stroke="#dce5ec" stroke-width="6" stroke-linecap="round" />
      <path d="M190 330h217" stroke="#168ac5" stroke-width="6" stroke-linecap="round" />
      <circle cx="407" cy="330" r="9" fill="#fff" stroke="#168ac5" stroke-width="3" />
      <text x="526" y="337" class="muted">70%</text>
      <rect x="616" y="310" width="118" height="40" rx="7" fill="#fff" stroke="#d5e0e7" />
      <text x="675" y="337" text-anchor="middle" class="muted">{copy.preview}</text>
      <rect class="apply-button animated" x="616" y="366" width="118" height="40" rx="7" fill="#168ac5" />
      <text x="675" y="393" text-anchor="middle" class="button-text">{copy.apply}</text>
    </g>

    <g class="downloads animated">
      <text x="66" y="128" class="heading">{copy.downloads}</text>
      <text x="734" y="125" text-anchor="end" class="eyebrow">{copy.downloadStep}</text>
      <rect x="66" y="153" width="668" height="178" rx="12" fill="#f8fafc" stroke="#e0e7ed" />
      <rect x="88" y="180" width="60" height="76" rx="8" fill="#e2f1fa" />
      <path d="M105 194h19l9 9v31h-28Z" fill="#fff" stroke="#168ac5" stroke-width="2" stroke-linejoin="round" />
      <path d="M124 194v10h9M112 216h14m-14 7h14" fill="none" stroke="#168ac5" stroke-width="2" />
      <text x="170" y="198" class="document-title">{copy.document}</text>
      <text x="170" y="229" class="filename">DownloadIt-guide.pdf</text>
      <g class="idle animated"><text x="170" y="260" class="muted">{copy.ready}</text></g>
      <g class="in-progress animated"><text x="170" y="260" class="muted">{copy.downloading}</text></g>
      <g class="finished animated"><text x="170" y="260" class="success-text">{copy.complete}</text></g>
      <g class="download-button animated">
        <rect x="592" y="198" width="120" height="44" rx="8" fill="#168ac5" />
        <text x="652" y="227" text-anchor="middle" class="button-text">{copy.download}</text>
      </g>
      <g class="finished animated" fill="none" stroke="#2b7a5b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="675" cy="219" r="20" fill="#e6f4ec" stroke="none" />
        <path d="m665 219 7 7 13-14" />
      </g>
      <rect x="88" y="291" width="624" height="6" rx="3" fill="#e0e8ee" />
      <rect class="progress animated" x="88" y="291" width="624" height="6" rx="3" fill="#168ac5" />
      <g class="chime animated">
        <rect x="66" y="351" width="668" height="56" rx="10" fill="#ecf7f0" />
        <g fill="none" stroke="#2b7a5b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M89 374h8l10-8v26l-10-8h-8Z" fill="#2b7a5b" stroke="none" />
          <path class="wave wave-one animated" d="M114 372a11 11 0 0 1 0 14" />
          <path class="wave wave-two animated" d="M121 366a20 20 0 0 1 0 26" />
        </g>
        <text x="146" y="386" class="success-text">{copy.chime}</text>
        <text x="710" y="385" text-anchor="end" class="chime-note">{copy.chimeNote}</text>
      </g>
    </g>

    <g class="cursor animated" fill="#172e40" stroke="#fff" stroke-width="2.5" stroke-linejoin="round">
      <path d="m0 0 3 27 7-7 6 12 6-3-6-12 10-1Z" />
    </g>
    <g class="click-ring animated" fill="none" stroke="#168ac5" stroke-width="3"><circle r="20" /></g>
    <g class="step step-one animated"><text x="34" y="469">{copy.stepOne}</text></g>
    <g class="step step-two animated"><text x="34" y="469">{copy.stepTwo}</text></g>
    <g class="step step-three animated"><text x="34" y="469">{copy.stepThree}</text></g>
  </svg>
  <button class="playback" type="button" data-play={copy.play} data-replay={copy.replay} data-stop={copy.stop} data-loading={copy.loading} hidden>
    <span class="control">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <rect class="stop-icon" x="3" y="3" width="10" height="10" rx="1" />
        <path class="play-icon" d="m5 3 8 5-8 5Z" />
      </svg>
      <span class="control-label">{copy.play}</span>
    </span>
  </button>
  <p class="sound-error" role="status" data-message={copy.error} hidden></p>
  <span hidden data-sound-url={completionSound}></span>
</download-sound-demo>

<script>
  class DownloadSoundDemo extends HTMLElement {
    private context: AudioContext | null = null;
    private source: AudioBufferSourceNode | null = null;
    private generation = 0;

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      const button = this.querySelector<HTMLButtonElement>("button");
      if (!button) return;
      button.hidden = false;
      button.addEventListener("click", () => {
        if (this.dataset.state === "playing") this.reset();
        else void this.play();
      });
    }

    private setState(state: "idle" | "loading" | "playing" | "ended") {
      this.dataset.state = state;
      const button = this.querySelector<HTMLButtonElement>("button")!;
      button.disabled = state === "loading";
      this.querySelector(".control-label")!.textContent = button.dataset[
        state === "playing" ? "stop" : state === "ended" ? "replay" : state === "loading" ? "loading" : "play"
      ] ?? "";
    }

    private reset() {
      this.generation++;
      this.source?.stop();
      this.source = null;
      void this.context?.close();
      this.context = null;
      this.setState("idle");
    }

    private async play() {
      this.reset();
      const generation = this.generation;
      const errorMessage = this.querySelector<HTMLParagraphElement>(".sound-error")!;
      errorMessage.hidden = true;
      errorMessage.textContent = "";
      this.setState("loading");
      try {
        // Resume within the click gesture so the later chime is permitted by autoplay policy.
        const context = new AudioContext();
        this.context = context;
        const url = this.querySelector<HTMLElement>("[data-sound-url]")!.dataset.soundUrl!;
        const [response] = await Promise.all([fetch(url), context.resume()]);
        if (!response.ok) throw new Error("Sound asset unavailable");
        const buffer = await context.decodeAudioData(await response.arrayBuffer());
        if (generation !== this.generation) return;

        const source = context.createBufferSource();
        source.buffer = buffer;
        const gain = context.createGain();
        gain.gain.value = 0.7;
        source.connect(gain).connect(context.destination);
        this.source = source;
        this.setState("playing");
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const animations = this.querySelector(".scene")!.getAnimations({ subtree: true });
        // The completed frame starts at 75% of the 12-second animation.
        source.start(context.currentTime + (reducedMotion ? 0 : 9));
        const soundEnded = new Promise<void>(resolve => { source.onended = () => resolve(); });
        await Promise.all([soundEnded, ...animations.map(animation => animation.finished)]);
        if (generation !== this.generation) return;
        this.source = null;
        this.context = null;
        void context.close();
        this.setState("ended");
      } catch {
        if (generation !== this.generation) return;
        this.reset();
        errorMessage.hidden = false;
        errorMessage.textContent = errorMessage.dataset.message ?? "";
      }
    }

    disconnectedCallback() {
      this.reset();
    }
  }
  if (!customElements.get("download-sound-demo")) {
    customElements.define("download-sound-demo", DownloadSoundDemo);
  }
</script>

<style>
  download-sound-demo { display: block; position: relative; width: 100%; min-width: 0; line-height: 1; color-scheme: light; }
  .scene { display: block; width: 100%; height: auto; font-family: var(--__sl-font), sans-serif; fill: #263b4b; }
  .brand { font-size: 21px; font-weight: 600; }
  .heading { font-size: 27px; font-weight: 600; }
  .eyebrow { font-size: 15px; fill: #61798c; letter-spacing: 1px; }
  .label, .document-title { font-size: 23px; font-weight: 500; }
  .muted, .filename { font-size: 21px; fill: #586e80; }
  .filename { font-size: 20px; }
  .button-text { font-size: 21px; fill: #fff; font-weight: 500; }
  .success-text { fill: #236747; font-size: 21px; font-weight: 500; }
  .chime-note { font-size: 17px; fill: #426f59; }
  .step { font-size: 20px; fill: #496477; }
  .animated { animation-duration: 12s; animation-iteration-count: 1; animation-timing-function: linear; animation-fill-mode: both; }
  [data-state="idle"] .animated, [data-state="loading"] .animated { animation: none; }
  [data-state="idle"] .cursor, [data-state="loading"] .cursor { opacity: 0; }
  [data-state="idle"] .step-one, [data-state="loading"] .step-one { visibility: hidden; }
  .settings { animation-name: settings; }
  .sound-toggle { animation-name: toggle; }
  .sound-thumb { animation-name: thumb; }
  .apply-button { animation-name: apply; }
  .downloads { opacity: 0; animation-name: downloads; }
  .cursor { animation-name: cursor; }
  .click-ring { opacity: 0; animation-name: clicks; }
  .progress { transform-box: fill-box; transform-origin: left; transform: scaleX(0); animation-name: progress; }
  .idle, .download-button { animation-name: idle; }
  .in-progress { opacity: 0; animation-name: downloading; }
  .finished, .chime { opacity: 0; animation-name: finished; }
  .wave-one { animation-name: wave-one; }
  .wave-two { animation-name: wave-two; }
  .step-one { animation-name: settings; }
  .step-two { opacity: 0; animation-name: step-two; }
  .step-three { opacity: 0; animation-name: finished; }
  .playback { position: absolute; right: 4%; bottom: 2.5%; display: flex; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 6px; background: transparent; color: #fff; font: inherit; font-size: clamp(0.7rem, 1vw, 0.85rem); cursor: pointer; }
  .control { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 0.7rem; border-radius: 6px; background: #087eb6; box-shadow: 0 1px 4px #1234; }
  [data-state="idle"] .playback, [data-state="loading"] .playback { inset: 0; align-items: flex-end; padding-bottom: 2.5%; }
  .playback[hidden] { display: none; }
  .playback:hover .control { background: #075985; }
  .playback:focus-visible { outline: 3px solid #168ac5; outline-offset: 3px; }
  .stop-icon { display: none; }
  [data-state="playing"] .stop-icon { display: block; }
  [data-state="playing"] .play-icon { display: none; }
  .sound-error { position: absolute; bottom: 15%; left: 4%; width: 92%; margin: 0; padding: 0.35rem 0.5rem; background: #fff7ed; color: #9a3412; font-size: 0.8rem; line-height: 1.4; z-index: 1; }
  .sound-error[hidden] { display: none; }

  @keyframes settings { 0%, 33% { opacity: 1; } 37%, 100% { opacity: 0; } }
  @keyframes downloads { 0%, 33% { opacity: 0; } 37%, 100% { opacity: 1; } }
  @keyframes toggle { 0%, 18% { fill: #c6d0da; } 19%, 100% { fill: #168ac5; } }
  @keyframes thumb { 0%, 18% { transform: translateX(0); } 19%, 100% { transform: translateX(26px); } }
  @keyframes apply { 0%, 28%, 32%, 100% { fill: #168ac5; } 29%, 31% { fill: #075985; } }
  @keyframes cursor {
    0%, 5% { opacity: 0; transform: translate(740px, 280px); }
    12%, 18% { opacity: 1; transform: translate(702px, 217px); }
    19%, 21% { opacity: 1; transform: translate(702px, 220px); }
    27%, 29% { opacity: 1; transform: translate(675px, 386px); }
    32% { opacity: 0; transform: translate(675px, 389px); }
    38% { opacity: 0; transform: translate(733px, 280px); }
    45%, 48% { opacity: 1; transform: translate(652px, 221px); }
    50% { opacity: 1; transform: translate(652px, 224px); }
    54%, 100% { opacity: 0; transform: translate(672px, 248px); }
  }
  @keyframes clicks {
    0%, 17% { opacity: 0; transform: translate(702px, 217px) scale(0.5); }
    18% { opacity: 0.7; transform: translate(702px, 217px) scale(0.5); }
    21% { opacity: 0; transform: translate(702px, 217px) scale(1.3); }
    27% { opacity: 0; transform: translate(675px, 386px) scale(0.5); }
    29% { opacity: 0.7; transform: translate(675px, 386px) scale(0.5); }
    32% { opacity: 0; transform: translate(675px, 386px) scale(1.3); }
    46% { opacity: 0; transform: translate(652px, 221px) scale(0.5); }
    48% { opacity: 0.7; transform: translate(652px, 221px) scale(0.5); }
    51%, 100% { opacity: 0; transform: translate(652px, 221px) scale(1.3); }
  }
  @keyframes idle { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes downloading { 0%, 49% { opacity: 0; } 50%, 73% { opacity: 1; } 74%, 100% { opacity: 0; } }
  @keyframes progress { 0%, 49% { transform: scaleX(0); fill: #168ac5; } 61% { transform: scaleX(0.4); } 73% { transform: scaleX(1); fill: #168ac5; } 74%, 100% { transform: scaleX(1); fill: #2b7a5b; } }
  @keyframes finished { 0%, 73% { opacity: 0; } 75%, 100% { opacity: 1; } }
  @keyframes step-two { 0%, 36% { opacity: 0; } 38%, 73% { opacity: 1; } 75%, 100% { opacity: 0; } }
  @keyframes wave-one { 0%, 74%, 80%, 88%, 96%, 100% { opacity: 0.2; } 77%, 85%, 93% { opacity: 1; } }
  @keyframes wave-two { 0%, 76%, 84%, 92%, 100% { opacity: 0.2; } 80%, 88%, 96% { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .animated { animation: none !important; }
    :is([data-state="playing"], [data-state="ended"]) :is(.settings, .cursor, .click-ring, .idle, .download-button, .in-progress, .step-one, .step-two) { display: none; }
    :is([data-state="playing"], [data-state="ended"]) :is(.downloads, .finished, .chime, .step-three, .wave) { opacity: 1; }
    :is([data-state="playing"], [data-state="ended"]) .progress { transform: scaleX(1); fill: #2b7a5b; }
  }
</style>
