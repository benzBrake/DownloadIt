---
import { Download } from "lucide-astro";
import { product } from "../data/product";
import { currentLocale } from "../data/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const locale = currentLocale(Astro.locals.starlightRoute.lang);
const label =
  locale === "zh-CN"
    ? `下载 Nightly v${product.version}`
    : `Download Nightly v${product.version}`;
---

<a
  class:list={["nightly-link", { compact }]}
  href={product.downloadUrl}
  aria-label={label}
>
  <span class="icon" aria-hidden="true">
    <Download size={compact ? 16 : 20} strokeWidth={2} />
  </span>
  <span class="content">
    <span class="label">{label}</span>
    {!compact && <small>Pre-release</small>}
  </span>
  {compact && <small>Pre-release</small>}
</a>

<style>
  .nightly-link {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    gap: 0.8rem;
    margin-block: 1.25rem 1.5rem;
    padding: 0.65rem 1.1rem 0.65rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--downloadit-orange) 52%, var(--sl-color-hairline));
    border-radius: 4px;
    background: color-mix(in srgb, var(--downloadit-orange) 8%, var(--sl-color-bg));
    color: var(--sl-color-white);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .nightly-link:hover {
    border-color: var(--downloadit-orange);
    background: color-mix(in srgb, var(--downloadit-orange) 15%, var(--sl-color-bg));
    transform: translateY(-1px);
  }

  .icon {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 3px;
    background: color-mix(in srgb, var(--downloadit-orange) 18%, transparent);
    color: var(--downloadit-orange);
  }

  .content {
    display: grid;
    gap: 0.18rem;
  }

  .label {
    white-space: nowrap;
  }

  small {
    color: var(--sl-color-gray-4);
    font-family: var(--__sl-font-mono);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .compact {
    min-height: 2.25rem;
    gap: 0.5rem;
    margin-block: 0;
    padding: 0.45rem 0.7rem;
    font-size: var(--sl-text-sm);
  }

  .compact .icon {
    width: auto;
    height: auto;
    background: transparent;
    color: currentColor;
  }

  .compact .content {
    display: contents;
  }

  .compact small {
    padding-inline-start: 0.55rem;
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  @media (max-width: 30rem) {
    .nightly-link:not(.compact) {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nightly-link {
      transition: none;
    }

    .nightly-link:hover {
      transform: none;
    }
  }
</style>
