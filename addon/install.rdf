<?xml version="1.0"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:id>downloadit@downloadit.invalid</em:id>
    <em:name>DownloadIt</em:name>
    <em:version>2.14.4</em:version>
    <em:updateURL>https://github.com/benzBrake/DownloadIt/releases/download/nightly/update.rdf</em:updateURL>
    <em:type>2</em:type>
    <em:bootstrap>true</em:bootstrap>
    <em:description>Enhance Firefox downloads with download-manager integration, batch link tools, and flexible download handling.</em:description>
    <em:creator>Ryan</em:creator>
    <em:contributor>Codex</em:contributor>
    <em:contributor>Giorgio Maone (original FlashGot)</em:contributor>
    <em:optionsURL>chrome://downloadit/content/options.xhtml</em:optionsURL>
    <em:optionsType>1</em:optionsType>
    <em:optionsResizable>true</em:optionsResizable>
    <em:optionsWidth>1080</em:optionsWidth>
    <em:optionsHeight>720</em:optionsHeight>
    <em:iconURL>chrome://downloadit/content/icons/downloadit.svg</em:iconURL>

    <em:targetApplication>
      <Description>
        <em:id>{ec8030f7-c20a-464f-9b0e-13a3a9e97384}</em:id>
        <em:minVersion>136.0</em:minVersion>
        <em:maxVersion>*</em:maxVersion>
      </Description>
    </em:targetApplication>

    <em:localized>
      <Description>
        <em:locale>zh-CN</em:locale>
        <em:name>DownloadIt</em:name>
        <em:description>增强 Firefox 下载体验，提供下载器集成、批量链接工具和灵活的下载处理。</em:description>
      </Description>
    </em:localized>
    <em:localized>
      <Description>
        <em:locale>ja</em:locale>
        <em:name>DownloadIt</em:name>
        <em:description>ダウンロードマネージャー連携、リンクの一括処理、柔軟なダウンロード処理で Firefox のダウンロード体験を向上させます。</em:description>
      </Description>
    </em:localized>
    <em:localized>
      <Description>
        <em:locale>zh-TW</em:locale>
        <em:name>DownloadIt</em:name>
        <em:description>增強 Firefox 下載體驗，提供下載工具整合、批次連結工具與彈性的下載處理。</em:description>
      </Description>
    </em:localized>
  </Description>
</RDF>
